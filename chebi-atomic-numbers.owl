<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/cthoyt/chebi-atomic-numbers-ontology/raw/refs/heads/main/chebi-atomic-numbers.owl#"
     xml:base="https://github.com/cthoyt/chebi-atomic-numbers-ontology/raw/refs/heads/main/chebi-atomic-numbers.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://github.com/cthoyt/chebi-atomic-numbers-ontology/raw/refs/heads/main/chebi-atomic-numbers.owl">
        <dcterms:creator rdf:resource="https://orcid.org/0000-0003-4423-4370"/>
        <dcterms:description>An ontology that does axiom injection to ChEBI terms representing atoms by adding a data property to their atomic number.</dcterms:description>
        <dcterms:license rdf:resource="https://spdx.org/licenses/CC0-1.0"/>
        <dcterms:title>ChEBI Atomic Numbers Ontology</dcterms:title>
        <doap:Repository rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/cthoyt/chebi-atomic-numbers-ontology</doap:Repository>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://usefulinc.com/ns/doap#Repository -->

    <owl:AnnotationProperty rdf:about="http://usefulinc.com/ns/doap#Repository"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://chemkg.github.io/chemrof/atomic_number -->

    <owl:DatatypeProperty rdf:about="https://chemkg.github.io/chemrof/atomic_number">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>atomic number</rdfs:label>
    </owl:DatatypeProperty>
    


