Prefix(:=<https://github.com/cthoyt/chebi-element-extension-ontology/raw/refs/heads/main/elements.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<https://github.com/cthoyt/chebi-element-extension-ontology/raw/refs/heads/main/elements.owl>
Annotation(dcterms:creator <https://orcid.org/0000-0003-4423-4370>)
Annotation(dcterms:description "An ontology that does axiom injection to ChEBI terms representing atoms by adding a data property to their atomic number.")
Annotation(dcterms:license <https://spdx.org/licenses/CC0-1.0>)
Annotation(dcterms:title "ChEBI Element Extension Ontology")
Annotation(<http://usefulinc.com/ns/doap#Repository> "https://github.com/cthoyt/chebi-element-extension-ontology"^^xsd:anyURI)

Declaration(Class(<http://purl.obolibrary.org/NCBITaxon_9606>))
Declaration(Class(<https://spdx.org/licenses/CC0-1.0>))
Declaration(NamedIndividual(<https://orcid.org/0000-0003-4423-4370>))
Declaration(AnnotationProperty(dcterms:creator))
Declaration(AnnotationProperty(dcterms:description))
Declaration(AnnotationProperty(dcterms:license))
Declaration(AnnotationProperty(dcterms:title))
Declaration(AnnotationProperty(<http://usefulinc.com/ns/doap#Repository>))


############################
#   Classes
############################

# Class: <http://purl.obolibrary.org/NCBITaxon_9606> (human)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/NCBITaxon_9606> "human")

# Class: <https://spdx.org/licenses/CC0-1.0> (CC0 1.0)

AnnotationAssertion(rdfs:label <https://spdx.org/licenses/CC0-1.0> "CC0 1.0")


############################
#   Named Individuals
############################

# Individual: <https://orcid.org/0000-0003-4423-4370> (Charles Tapley Hoyt)

AnnotationAssertion(rdfs:label <https://orcid.org/0000-0003-4423-4370> "Charles Tapley Hoyt")
ClassAssertion(<http://purl.obolibrary.org/NCBITaxon_9606> <https://orcid.org/0000-0003-4423-4370>)


)